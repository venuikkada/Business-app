# Copy to deploy/hostinger/.env on the server (never commit it).
# ./setup.sh fills the secret values for you on first run.

# Domains — point both A records at the VPS IP first (hPanel → Domains → DNS).
APP_DOMAIN=app.your-domain.in
ADMIN_DOMAIN=admin.your-domain.in
ACME_EMAIL=you@your-domain.in

# Generated secrets (openssl rand). Keep a copy in your password manager.
DB_OWNER_PASSWORD=
CBA_APP_PASSWORD=
CBA_PLATFORM_PASSWORD=
APP_SECRET=
CRON_SECRET=

# Optional: only these IPs may open the admin panel (comma separated).
ADMIN_ALLOWED_IPS=

# Email (needed for verification, password reset, invitations).
# Hostinger email: smtps://you%40your-domain.in:PASSWORD@smtp.hostinger.com:465
MAIL_FROM="CRAZY BUSINESS APP <no-reply@your-domain.in>"
SMTP_URL=

# Razorpay (leave empty until KYC is done).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
