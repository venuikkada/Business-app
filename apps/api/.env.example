# Copy into hPanel → Websites → your site → Node.js → Environment variables
# (or a .env file you load yourself). NEVER commit real values to Git.
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://your-domain.in
TRUST_PROXY=1

# Hostinger managed MySQL (hPanel → Databases). From the app use 127.0.0.1, not srvNNNN.hstgr.io.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u123456789_bizapp
DB_USER=u123456789_bizapp
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=8

# Or set AUTO_SECRETS=true (with STORAGE_DIR) and leave the first three empty: the server creates them
# once in STORAGE_DIR/.app-secrets.json. Back that file up.
AUTO_SECRETS=false
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
OTP_SECRET=
DATA_ENCRYPTION_KEY=
CRON_SECRET=

# SMS for OTP (India): MSG91 with a DLT-approved OTP template that has a variable named "otp"
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Max OTP SMS per day for the whole app (bot protection). Raise as you grow.
OTP_GLOBAL_DAILY_LIMIT=3000

# Uploaded files, PDFs and backups. Must be OUTSIDE public_html.
STORAGE_DIR=/home/u123456789/bizapp-storage

# Apply new database migrations automatically when the app starts (recommended on Hostinger).
MIGRATE_ON_START=true
