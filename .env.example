# CRAZY BUSINESS APP — environment template.
# Copy to apps/web/.env.local (web + API) and apps/admin/.env.local (super-admin).
# NEVER commit real values. All of these are SERVER-SIDE ONLY; none are sent to
# browsers or the Android app.

# ---------------------------------------------------------------- database
# Tenant traffic: the RLS-restricted role (no BYPASSRLS, no table ownership).
DATABASE_URL=postgres://cba_app:CHANGE_ME@localhost:5432/cba_dev
# Super-admin traffic: platform tables only (no grants on tenant tables).
# The admin app needs ONLY this one — do not give it DATABASE_URL.
PLATFORM_DATABASE_URL=postgres://cba_platform:CHANGE_ME@localhost:5432/cba_dev
# Schema owner, used only by migrations / setup scripts (never by the running apps).
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/cba_dev
# Optional pool size per process (default 10).
# DB_POOL_MAX=10

# ---------------------------------------------------------------- secrets
# 32+ random characters. Encrypts TOTP secrets (AES-256-GCM via HKDF). Rotating it
# invalidates enrolled authenticator apps. Generate: openssl rand -base64 48
APP_SECRET=
# Bearer secret for POST /api/v1/cron/daily (scheduler → app). openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------- URLs
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Admin app only: comma-separated IPs allowed to reach the admin panel (empty = any).
# ADMIN_ALLOWED_IPS=203.0.113.10,203.0.113.11

# ---------------------------------------------------------------- email
MAIL_FROM="CRAZY BUSINESS APP <no-reply@your-domain.in>"
# smtps://user:pass@host:465 (TLS) or smtp://user:pass@host:587 (STARTTLS enforced).
# URL-encode special characters in the password. Empty in dev = emails are printed to the console.
SMTP_URL=

# ---------------------------------------------------------------- file storage
# local (dev / single server) or s3 (any S3-compatible store: AWS S3 ap-south-1, Cloudflare R2, …)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=            # only for non-AWS providers
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SSE=AES256           # optional server-side encryption

# ---------------------------------------------------------------- payments (Razorpay)
# Leave empty to disable online checkout (plans can still be set by the super admin).
# RAZORPAY_KEY_ID is the only value shown to browsers (it is public by design).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- PDFs
# Folder with NotoSans-Regular.ttf / NotoSans-Bold.ttf (defaults to the bundled fonts).
# CBA_FONT_DIR=

# ---------------------------------------------------------------- setup / tests only
# CBA_APP_PASSWORD=          # used by `pnpm --filter @cba/server db:setup-roles`
# CBA_PLATFORM_PASSWORD=
# TEST_DB_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres   # tests create a throwaway DB
# DEMO_EMAIL=demo@crazybusiness.example
# DEMO_PASSWORD=
